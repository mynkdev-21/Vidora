<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="@dimen/content_gutter">
        <ImageView android:id="@+id/btn_back" style="@style/Vidora.Control.Icon"
            android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target"
            android:src="@drawable/ic_arrow_back" android:contentDescription="Back" />
        <TextView style="@style/Vidora.Text.Title" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_3"
            android:text="Creator studio" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="@dimen/content_gutter"
            android:paddingBottom="@dimen/space_6">
            <TextView style="@style/Vidora.Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage uploads and track your real results." />
            <TextView android:id="@+id/tv_studio_status" style="@style/Vidora.Text.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" android:text="Loading your stats…" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="@dimen/space_3">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_settings_card" android:padding="@dimen/space_4"
                    android:layout_marginEnd="@dimen/space_2">
                    <TextView android:id="@+id/tv_studio_files" style="@style/Vidora.Text.Title"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    <TextView style="@style/Vidora.Text.Caption" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Uploads" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_settings_card" android:padding="@dimen/space_4">
                    <TextView android:id="@+id/tv_studio_views" style="@style/Vidora.Text.Title"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" />
                    <TextView style="@style/Vidora.Text.Caption" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Views" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/btn_studio_upload" style="@style/Vidora.Control.Primary"
                android:layout_width="match_parent" android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_5" android:text="Upload a file" />
            <TextView android:id="@+id/btn_my_videos" style="@style/Vidora.Control.Secondary"
                android:layout_width="match_parent" android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_3" android:text="My files" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
