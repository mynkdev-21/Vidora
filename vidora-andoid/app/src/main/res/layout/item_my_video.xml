<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3" android:orientation="vertical"
    android:padding="@dimen/space_4" android:background="@drawable/bg_settings_card">
    <ImageView android:id="@+id/iv_thumbnail" android:layout_width="match_parent"
        android:layout_height="150dp" android:scaleType="centerCrop"
        android:background="@drawable/bg_thumbnail"
        android:contentDescription="File thumbnail" />
    <TextView android:id="@+id/tv_title" style="@style/Vidora.Text.Section"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/tv_meta" style="@style/Vidora.Text.Caption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="@dimen/space_3">
        <TextView android:id="@+id/btn_open" style="@style/Vidora.Control.Secondary"
            android:layout_width="0dp" android:layout_height="@dimen/touch_target"
            android:layout_weight="1" android:text="Open" />
        <TextView android:id="@+id/btn_share" style="@style/Vidora.Control.Secondary"
            android:layout_width="0dp" android:layout_height="@dimen/touch_target"
            android:layout_weight="1" android:layout_marginStart="@dimen/space_2"
            android:text="Share" />
        <TextView android:id="@+id/btn_delete" style="@style/Vidora.Control.Secondary"
            android:layout_width="0dp" android:layout_height="@dimen/touch_target"
            android:layout_weight="1" android:layout_marginStart="@dimen/space_2"
            android:text="Delete" android:textColor="@color/red_light" />
    </LinearLayout>
</LinearLayout>
