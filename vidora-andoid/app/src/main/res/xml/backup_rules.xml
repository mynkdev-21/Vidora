<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower (android:fullBackupContent).
     Auth tokens (vidora_prefs) are never backed up: restoring them onto
     another device would carry a live session with it. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="vidora_prefs.xml" />
    <exclude domain="sharedpref" path="vidora_secure_tokens.xml" />
    <exclude domain="sharedpref" path="device.xml" />
</full-backup-content>
