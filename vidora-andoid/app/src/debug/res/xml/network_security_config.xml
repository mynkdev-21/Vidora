<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP so the app can reach a local backend
     (emulator 10.0.2.2 or a LAN IP). Never shipped in release builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
