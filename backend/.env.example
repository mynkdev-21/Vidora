# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development            # "production" enables strict config validation
PORT=5001
BASE_URL=http://localhost:5001  # public API URL (https:// required in production)
SHARE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:8080
# Browser origins allowed by CORS (comma-separated). CORS is not authentication.
FRONTEND_ORIGINS=http://localhost:8080

# Reverse proxy: how many proxy hops (or which proxy addresses) to trust for
# X-Forwarded-For. Leave empty when the API is exposed directly. Behind one
# nginx / load balancer use 1. Never "true" unless every request goes through a
# proxy that overwrites X-Forwarded-For.
TRUST_PROXY=

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=videora

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 48   (must differ; production refuses
# placeholders and anything shorter than 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Client API keys ──────────────────────────────────────────────────────────
# key:label pairs. These identify the client (web, mobile); they ship inside
# the apps and are NOT secrets. Rotate a key to cut off an abusive client.
# Generate with: echo "vdr_live_$(openssl rand -hex 16)"
API_KEYS=vdr_live_REPLACE_ME_WEB:web,vdr_live_REPLACE_ME_MOBILE:mobile

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOADS_DIR=uploads             # relative to the backend working directory
MAX_UPLOAD_BYTES=10737418240    # 10 GB

# ── Telegram bot (optional) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
