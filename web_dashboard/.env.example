# Backend API base URL
VITE_API_URL=http://localhost:5001
# Public client identifier for the web app (the key labelled "web"/"frontend"
# in the backend's API_KEYS). It ships in the browser bundle — NOT a secret.
VITE_API_KEY=

# Desktop installer downloads (GitHub Release assets by default)
VITE_DESKTOP_VERSION=1.0.0
# Override when installers are hosted elsewhere (required if the repo is private)
VITE_DESKTOP_DOWNLOAD_BASE=
